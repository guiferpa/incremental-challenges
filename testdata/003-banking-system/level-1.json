        {"op": "transfer", "args": {"timestamp": 3, "source_id": "x", "target_id": "ghost", "amount": 10}, "expected": null},
        {"op": "transfer", "args": {"timestamp": 4, "source_id": "ghost", "target_id": "x", "amount": 10}, "expected": null},
