{
  "challenge": "001-log-parser",
  "level": 3,
  "cases": [
    {
      "name": "spec example",
      "operations": [
        {"op": "analyze_sessions", "args": {"lines": ["[2026-06-06T10:00:00Z] INFO: Login session_id=abc", "[2026-06-06T10:00:02Z] INFO: Login session_id=xyz", "[2026-06-06T10:00:03Z] ERROR: Payment declined session_id=abc", "[2026-06-06T10:00:04Z] INFO: Health check ok", "[2026-06-06T10:00:10Z] ERROR: Timeout [session_id: abc]", "[2026-06-06T10:00:01Z] WARN: Retrying session_id=xyz", "[2026-06-06T10:00:05Z] INFO: Logout session_id=qwe"]}, "expected": [{"session_id": "abc", "duration_ms": 10000, "error_count": 2}, {"session_id": "xyz", "duration_ms": 1000, "error_count": 0}, {"session_id": "qwe", "duration_ms": 0, "error_count": 0}]}
      ]
    },
    {
      "name": "ties are sorted by session_id",
      "operations": [
        {"op": "analyze_sessions", "args": {"lines": ["[2026-06-06T10:00:00Z] INFO: Start session_id=b", "[2026-06-06T10:01:00Z] INFO: Start session_id=m", "[2026-06-06T10:00:00Z] INFO: Start session_id=m", "[2026-06-06T10:00:00Z] ERROR: Crash session_id=a"]}, "expected": [{"session_id": "m", "duration_ms": 60000, "error_count": 0}, {"session_id": "a", "duration_ms": 0, "error_count": 1}, {"session_id": "b", "duration_ms": 0, "error_count": 0}]}
      ]
    },
    {
      "name": "errors without a session are ignored",
      "operations": [
        {"op": "analyze_sessions", "args": {"lines": ["[2026-06-06T10:00:00Z] ERROR: Disk full", "[2026-06-06T10:00:01Z] INFO: Open [session_id: s1]", "[2026-06-06T10:00:02Z] ERROR: Broken session_id=s1", "garbage session_id=s1", "[2026-06-06T10:00:04Z] WARN: Closing session_id=s1"]}, "expected": [{"session_id": "s1", "duration_ms": 3000, "error_count": 1}]}
      ]
    },
    {
      "name": "no sessions",
      "operations": [
        {"op": "analyze_sessions", "args": {"lines": ["[2026-06-06T10:00:00Z] INFO: Server started"]}, "expected": []},
        {"op": "analyze_sessions", "args": {"lines": []}, "expected": []}
      ]
    }
  ]
}
