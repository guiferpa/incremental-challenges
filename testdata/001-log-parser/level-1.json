{
  "challenge": "001-log-parser",
  "level": 1,
  "cases": [
    {
      "name": "spec example: parse each line",
      "operations": [
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T10:00:00Z] INFO: Server started"}, "expected": {"timestamp": 1780740000000, "level": "INFO", "message": "Server started"}},
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T10:00:05Z] ERROR: Connection timeout"}, "expected": {"timestamp": 1780740005000, "level": "ERROR", "message": "Connection timeout"}},
        {"op": "parse_line", "args": {"raw_line": "this line is garbage"}, "expected": null},
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T10:00:07Z] DEBUG: Unknown level"}, "expected": null}
      ]
    },
    {
      "name": "spec example: filter by level",
      "operations": [
        {"op": "filter_by_level", "args": {"lines": ["[2026-06-06T10:00:00Z] INFO: Server started", "[2026-06-06T10:00:05Z] ERROR: Connection timeout", "this line is garbage", "[2026-06-06T10:00:07Z] DEBUG: Unknown level"], "level": "ERROR"}, "expected": [{"timestamp": 1780740005000, "level": "ERROR", "message": "Connection timeout"}]},
        {"op": "filter_by_level", "args": {"lines": ["[2026-06-06T10:00:00Z] INFO: Server started", "[2026-06-06T10:00:05Z] ERROR: Connection timeout", "this line is garbage", "[2026-06-06T10:00:07Z] DEBUG: Unknown level"], "level": "INFO"}, "expected": [{"timestamp": 1780740000000, "level": "INFO", "message": "Server started"}]},
        {"op": "filter_by_level", "args": {"lines": ["[2026-06-06T10:00:00Z] INFO: Server started", "[2026-06-06T10:00:05Z] ERROR: Connection timeout", "this line is garbage", "[2026-06-06T10:00:07Z] DEBUG: Unknown level"], "level": "WARN"}, "expected": []}
      ]
    },
    {
      "name": "valid lines",
      "operations": [
        {"op": "parse_line", "args": {"raw_line": "[1970-01-01T00:00:00Z] INFO: Epoch"}, "expected": {"timestamp": 0, "level": "INFO", "message": "Epoch"}},
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T10:00:00Z] WARN: Disk usage at 91%"}, "expected": {"timestamp": 1780740000000, "level": "WARN", "message": "Disk usage at 91%"}},
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T23:59:59Z] ERROR: Message with: colons and [brackets]"}, "expected": {"timestamp": 1780790399000, "level": "ERROR", "message": "Message with: colons and [brackets]"}}
      ]
    },
    {
      "name": "malformed lines",
      "operations": [
        {"op": "parse_line", "args": {"raw_line": ""}, "expected": null},
        {"op": "parse_line", "args": {"raw_line": "2026-06-06T10:00:00Z INFO: Missing brackets"}, "expected": null},
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T10:00:00Z] INFO Missing colon"}, "expected": null},
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T10:00:00Z] error: Lowercase level"}, "expected": null},
        {"op": "parse_line", "args": {"raw_line": "[2026-02-30T10:00:00Z] INFO: February 30th"}, "expected": null},
        {"op": "parse_line", "args": {"raw_line": "[2026-06-06T24:00:00Z] INFO: Hour 24"}, "expected": null},
        {"op": "parse_line", "args": {"raw_line": "[06/06/2026 10:00:00] INFO: Wrong date format"}, "expected": null}
      ]
    },
    {
      "name": "filter keeps original order",
      "operations": [
        {"op": "filter_by_level", "args": {"lines": ["[2026-06-06T10:00:02Z] WARN: Second", "[2026-06-06T10:00:03Z] INFO: Other", "[2026-06-06T10:00:01Z] WARN: First but later in the file"], "level": "WARN"}, "expected": [{"timestamp": 1780740002000, "level": "WARN", "message": "Second"}, {"timestamp": 1780740001000, "level": "WARN", "message": "First but later in the file"}]}
      ]
    }
  ]
}
