      "operations": [
        {"op": "add_zone", "args": {"zone_id": "root", "parent_id": ""}, "expected": true},
        {"op": "add_zone", "args": {"zone_id": "z", "parent_id": "root"}, "expected": true},
        {"op": "add_zone", "args": {"zone_id": "a", "parent_id": "root"}, "expected": true},
        {"op": "add_zone", "args": {"zone_id": "m", "parent_id": "root"}, "expected": true},
        {"op": "add_zone", "args": {"zone_id": "a1", "parent_id": "a"}, "expected": true},
        {"op": "add_zone", "args": {"zone_id": "z1", "parent_id": "z"}, "expected": true},
