        {"op": "add_zone", "args": {"zone_id": "dungeon_1", "parent_id": "north_realm"}, "expected": true},
        {"op": "add_zone", "args": {"zone_id": "dungeon_2", "parent_id": "dungeon_1"}, "expected": true},
        {"op": "add_zone", "args": {"zone_id": "cave", "parent_id": "forest"}, "expected": true},
